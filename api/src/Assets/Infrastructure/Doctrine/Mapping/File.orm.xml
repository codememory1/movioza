<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Movioza\Assets\Domain\Entity\File" table="files">
        <id name="id" type="assets_file_id" length="32">
            <generator strategy="NONE" />
        </id>

        <field
            name="storageType"
            column="storage_type"
            enum-type="Movioza\Assets\Domain\Enum\StorageType"
            length="32"
        />
        <field name="bucket" type="assets_storage_bucket" length="255" />
        <field name="key" type="assets_storage_key" length="1024" unique="true" />
        <field name="extension" type="assets_file_extension" length="16" />
        <field name="size" type="assets_file_size" />

        <field name="createdAt" column="created_at" type="datetime_immutable" />
    </entity>
</doctrine-mapping>
