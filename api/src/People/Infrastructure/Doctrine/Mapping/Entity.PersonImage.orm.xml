<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Movioza\People\Domain\Entity\PersonImage" table="person_images">
        <id name="person" association-key="true" />
        <id name="imageId" column="image_id" type="people_image_id" />
        <id name="type" column="type" length="32" />

        <field name="createdAt" column="created_at" type="datetime_immutable" />

        <many-to-one field="person" target-entity="Movioza\People\Domain\Entity\Person" inversed-by="images">
            <join-column name="person_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </entity>
</doctrine-mapping>
