<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Movioza\Shared\Domain\Inbox\InboxMessage" table="inbox_messages">
        <lifecycle-callbacks>
            <lifecycle-callback type="prePersist" method="initializeCreatedAt" />
            <lifecycle-callback type="preUpdate" method="initializeUpdatedAt" />
        </lifecycle-callbacks>

        <id name="id" type="uuid">
            <generator strategy="CUSTOM" />
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UuidGenerator" />
        </id>

        <field name="idempotentKey" column="idempotent_key" length="255" unique="true" />
        <field name="status" column="status" length="32" enum-type="Movioza\Shared\Domain\Inbox\InboxMessageStatus" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" nullable="true" />
    </entity>
</doctrine-mapping>
