<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Movioza\Catalog\Domain\Entity\Episode" table="episodes">
        <unique-constraints>
            <unique-constraint name="uniq_episode_season_number" columns="season_id,number" />
        </unique-constraints>

        <id name="id" column="id" type="catalog_episode_id">
            <generator strategy="NONE" />
        </id>

        <field name="number" column="number" type="catalog_episode_number" />
        <field name="title" column="title" type="catalog_episode_title" />
        <field name="slug" column="slug" type="shared_slug" length="280" />
        <field name="description" column="description" type="text" nullable="true" />
        <field name="releasedAt" column="released_at" type="datetime_immutable" nullable="true" />
        <field name="uploadedAt" column="uploaded_at" type="datetime_immutable" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" nullable="true" />

        <many-to-one field="season" target-entity="Movioza\Catalog\Domain\Entity\Season" inversed-by="episodes">
            <join-column name="season_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <one-to-many field="images" target-entity="Movioza\Catalog\Domain\Entity\EpisodeImage" mapped-by="episode" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
