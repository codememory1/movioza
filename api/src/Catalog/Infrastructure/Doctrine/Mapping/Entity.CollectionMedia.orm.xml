<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Movioza\Catalog\Domain\Entity\CollectionMedia" table="collection_media">
        <id name="collection" association-key="true" />
        <id name="mediaId" column="media_id" type="catalog_media_id" />

        <field name="createdAt" column="created_at" type="datetime_immutable" />

        <many-to-one field="collection" target-entity="Movioza\Catalog\Domain\Entity\Collection" inversed-by="mediaItems">
            <join-column name="collection_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
    </entity>
</doctrine-mapping>
