<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Movioza\Catalog\Domain\Entity\MediaGenre" table="media_genres">
        <id name="media" association-key="true" />
        <id name="genreId" column="genre_id" type="catalog_genre_id" length="32" />

        <many-to-one field="media" target-entity="Movioza\Catalog\Domain\Entity\Media" inversed-by="genres">
            <join-column name="media_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <field name="createdAt" column="created_at" type="datetime_immutable" />
    </entity>
</doctrine-mapping>
