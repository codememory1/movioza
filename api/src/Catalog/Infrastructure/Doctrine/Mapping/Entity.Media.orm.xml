<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Movioza\Catalog\Domain\Entity\Media" table="media">
        <id name="id" column="id" type="catalog_media_id">
            <generator strategy="NONE" />
        </id>

        <field name="type" column="type" length="32" enum-type="Movioza\Catalog\Domain\Enum\MediaType" />
        <field name="kind" column="kind" nullable="true" length="32" enum-type="Movioza\Catalog\Domain\Enum\MediaKind" />
        <field name="title" column="title" type="catalog_media_title" length="255" />
        <field name="alternativeTitles" column="alternative_titles" type="catalog_media_titles" />
        <field name="slug" column="slug" type="shared_slug" length="280" />
        <field name="description" column="description" type="text" />
        <field name="ageRestrictions" column="age_restrictions" type="catalog_age_restriction" />

        <field name="uploadedAt" column="uploaded_at" type="datetime_immutable" nullable="true" />
        <field name="releasedAt" column="released_at" type="datetime_immutable" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" nullable="true" />

        <one-to-many field="seasons" target-entity="Movioza\Catalog\Domain\Entity\Season" mapped-by="media" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>

        <one-to-many field="images" target-entity="Movioza\Catalog\Domain\Entity\MediaImage" mapped-by="media" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>

        <one-to-many field="persons" target-entity="Movioza\Catalog\Domain\Entity\MediaPerson" mapped-by="media" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>

        <one-to-many field="countries" target-entity="Movioza\Catalog\Domain\Entity\MediaCountry" mapped-by="media" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>

        <one-to-many field="genres" target-entity="Movioza\Catalog\Domain\Entity\MediaGenre" mapped-by="media" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
