<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Movioza\Catalog\Domain\Entity\Collection" table="collections">
        <id name="id" column="id" type="catalog_collection_id">
            <generator strategy="NONE" />
        </id>

        <field name="slug" column="slug" type="shared_slug" length="280" />
        <field name="title" column="title" type="catalog_collection_title" length="100" />
        <field name="description" column="description" type="catalog_collection_description" length="255" />
        <field name="status" column="status" length="32" enum-type="Movioza\Catalog\Domain\Enum\CollectionStatus" />

        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="publishedAt" column="published_at" type="datetime_immutable" nullable="true" />
        <field name="unpublishedAt" column="unpublished_at" type="datetime_immutable" nullable="true" />
        <field name="archivedAt" column="archived_at" type="datetime_immutable" nullable="true" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" nullable="true" />

        <one-to-many field="mediaItems" target-entity="Movioza\Catalog\Domain\Entity\CollectionMedia" mapped-by="collection" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
