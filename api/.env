# Example defaults for local development.
# Override credentials and environment-specific settings in .env.local.
# Replace every change_me value before using the corresponding service.

# Application
APP_ENV=dev
APP_DEBUG=true
# Application secret; provide an environment-specific value.
APP_SECRET="change_me"
# Base directory for application runtime files.
APP_SHARE_DIR=var/share

# HTTP and routing
APP_PROTOCOL=http
APP_API_HOST="api.movioza.loc"
# Default origin for URLs generated outside an HTTP request.
DEFAULT_URI=http://api.movioza.loc

# PostgreSQL
DATABASE_HOST="postgres"
DATABASE_PORT=5432
DATABASE_NAME="movioza"
DATABASE_USER="movioza"
DATABASE_PASSWORD="change_me"
# Keep serverVersion consistent with the running PostgreSQL server.
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?serverVersion=16&charset=utf8"

# Redis
REDIS_SCHEME="tcp"
REDIS_HOST="redis"
# Redis server port inside the Docker network.
REDIS_PORT=6380
# Logical database for clients that use REDIS_DATABASE.
REDIS_DATABASE=1
REDIS_PASSWORD="change_me"

# API rate limiting
# Redis connection for counters and locks; uses database 0 independently of REDIS_DATABASE.
API_RATE_LIMITER_REDIS_URL="redis://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0"

# API response cache
# Connecting to Redis for caching API responses
API_RESPONSE_CACHE_REDIS_URL="redis://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0"
# Response cache lock TTL in seconds.
API_RESPONSE_CACHE_LOCK_TTL=30
# Maximum time to wait for a response cache lock, in seconds.
API_RESPONSE_CACHE_LOCK_WAIT_TIMEOUT=2
# Delay between response cache lock acquisition attempts, in microseconds.
API_RESPONSE_CACHE_LOCK_RETRY_DELAY_US=20000

# RabbitMQ and Messenger
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672
RABBITMQ_USER="movioza"
RABBITMQ_PASSWORD="change_me"
# The %2f suffix selects the RabbitMQ vhost named "/".
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/%2f"
MESSENGER_FAILED_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/%2f"

# S3-compatible object storage
S3_ENDPOINT="http://s3.movioza.loc:9000"
S3_REGION="us-east-1"
S3_VERSION="latest"
# Enable path-style requests for the local S3-compatible service.
S3_USE_PATH_STYLE_ENDPOINT=true
S3_ACCESS_KEY="movioza"
S3_SECRET_KEY="change_me"

# Assets
# Image URL lifetime, in seconds (1 hour).
ASSETS_IMAGE_URL_TTL=3600

# BunnyCDN
BUNNY_DOMAIN="https://your-zone.b-cdn.net"
# Key used for CDN token authentication.
BUNNY_SECRET_KEY="change_me"

# aria2
ARIA2_ENDPOINT="http://aria2.movioza.loc:6880"
# Authentication secret for aria2 RPC requests.
ARIA2_SECRET="change_me"

# Rutor tracker
# Comma-separated hosts accepted by the Rutor parser.
RUTOR_SUPPORTED_HOSTS="rutor.info,rutor.is,www.rutor.info,www.rutor.is"

# Identity
# Guest session lifetime, in seconds (30 days).
IDENTITY_GUEST_SESSION_TTL=2592000
# Set to true when the API is served over HTTPS.
IDENTITY_GUEST_SESSION_COOKIE_SECURE=false

# Catalog
# Maximum number of collections displayed on the main page.
CATALOG_MAIN_COLLECTIONS_LIMIT=6

# Fixtures
# S3 bucket used by fixtures.
FIXTURES_S3_BUCKET="test"

# Pagination
# HMAC key used to sign pagination cursors.
PAGINATION_CURSOR_SECRET="change_me"
