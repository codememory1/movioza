# Docker Compose environment template for local development.
# Copy to .env and replace every change_me_* value before running setup.
# Paths are relative to the project root. This file is also sourced by Bash.

# Docker
# Prefix added to container names.
DOCKER_CONTAINER_PREFIX="movioza"

# Environment-specific configuration directory under .docker.
DOCKER_ENV="dev"
DOCKER_ROOT_PATH="./.docker/${DOCKER_ENV}"

# Nginx
# HTTP port used by the Compose configuration.
NGINX_PORT=80

# Main Nginx configuration and virtual-host configuration.
NGINX_CONFIG="${DOCKER_ROOT_PATH}/nginx/nginx.conf"
NGINX_WWW_CONFIG="${DOCKER_ROOT_PATH}/nginx/www.conf"

# API
# Application source directory on the host and working directory in the container.
API_PATH="./api"
API_WORKDIR="/usr/src/api"

# Image build file and PHP / PHP-FPM configuration files.
API_DOCKER_FILE="${DOCKER_ROOT_PATH}/api/Dockerfile"
API_PHP_INI="${DOCKER_ROOT_PATH}/api/php.ini"
API_WWW_CONFIG="${DOCKER_ROOT_PATH}/api/www.conf"

# PostgreSQL
# PostgreSQL container image tag.
POSTGRES_VERSION="17.6-alpine"

# Database administrator credentials and application database name.
POSTGRES_USER="movioza"
POSTGRES_PASSWORD="change_me_postgres_password"
POSTGRES_DBNAME="movioza"

# PostgreSQL port used by the Compose configuration.
POSTGRES_PORT=5432

# Persistent database storage on the host.
POSTGRES_VOLUMES="./volumes/postgres"

# Server configuration and provisioning script directory.
POSTGRES_CONFIG="${DOCKER_ROOT_PATH}/postgres/postgresql.conf"
POSTGRES_PROVISION="${DOCKER_ROOT_PATH}/postgres/provision"

# Generated CDC provisioning SQL. Generate this file before mounting it.
POSTGRES_DEBEZIUM_SQL="./var/generated/postgres/debezium.sql"

# Redis
# Redis container image tag.
REDIS_VERSION="7.2.4"

# Redis port; keep the server configuration and Compose mapping consistent.
REDIS_PORT=6380

# Server configuration and persistent storage on the host.
REDIS_CONFIG="${DOCKER_ROOT_PATH}/redis/default.conf"
REDIS_VOLUMES="./volumes/redis"

# Password required by the Redis server.
REDIS_PASSWORD="change_me_redis_password"

# RabbitMQ
# RabbitMQ container image tag, including the management UI.
RABBITMQ_VERSION="4.1.2-management"

# Broker user credentials and virtual host included in generated definitions.
RABBITMQ_USER="movioza"
RABBITMQ_PASSWORD="change_me_rabbitmq_password"
RABBITMQ_VHOST="/"

# AMQP client port and management HTTP port, respectively.
RABBITMQ_API_PORT=5672
RABBITMQ_WEB_PORT=15672

# Persistent broker data and server configuration.
RABBITMQ_VOLUMES="./volumes/rabbitmq"
RABBITMQ_CONFIG="${DOCKER_ROOT_PATH}/rabbitmq/rabbitmq.conf"

# Generated broker definitions. Generate this file before starting RabbitMQ.
RABBITMQ_DEFINITIONS="./var/generated/rabbitmq/definitions.json"

# Hugging Face embeddings
# Embedding service image tag, port and model identifier.
HUGGINGFACE_EMBEDDINGS_VERSION="cpu-latest"
HUGGINGFACE_EMBEDDINGS_PORT=8080
HUGGINGFACE_EMBEDDINGS_MODEL_ID="intfloat/multilingual-e5-small"

# Persistent embedding service storage on the host.
HUGGINGFACE_EMBEDDINGS_VOLUMES="./volumes/huggingface-embeddings"

# MinIO
# MinIO container image tag and persistent storage on the host.
MINIO_VERSION="latest"
MINIO_VOLUMES="./volumes/minio"

# Local S3 endpoint hostname.
MINIO_HOST="s3.movioza.loc"

# S3 API port and administration console HTTP port, respectively.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO administrator credentials.
MINIO_ROOT_USER="movioza"
MINIO_ROOT_PASSWORD="change_me_minio_password"

# Aria2
# Aria2 container image tag.
ARIA2_VERSION="202209060423"

# Local RPC hostname and port.
ARIA2_HOST="aria2.movioza.loc"
ARIA2_RPC_PORT=6880

# Download directory on the host.
ARIA2_DOWNLOADS_VOLUMES="./aria2/downloads"

# Secret used to authenticate RPC requests.
ARIA2_RPC_SECRET="change_me_aria2_secret"

# Debezium
# Debezium Server container image tag.
DEBEZIUM_VERSION="2.7.3.Final"

# Administrative HTTP listener: host bind address/port and container port.
DEBEZIUM_EXTERNAL_PORT="127.0.0.1:8083"
DEBEZIUM_INTERNAL_PORT=8080

# Persisted connector offsets and Debezium Server configuration.
DEBEZIUM_VOLUMES="./volumes/debezium"
DEBEZIUM_CONFIG="${DOCKER_ROOT_PATH}/debezium/application.properties"

# PostgreSQL connection used by the CDC connector.
# The dedicated replication account is created by the provisioning SQL.
DEBEZIUM_POSTGRES_HOST="postgres"
DEBEZIUM_POSTGRES_USER="movioza_cdc"
DEBEZIUM_POSTGRES_PASSWORD="change_me_cdc_password"
DEBEZIUM_POSTGRES_DBNAME="${POSTGRES_DBNAME}"
DEBEZIUM_POSTGRES_PORT=5432

# Source schema and comma-separated table names without schema prefixes.
# Keep this list aligned with debezium.source.table.include.list.
DEBEZIUM_POSTGRES_SCHEMA="public"
DEBEZIUM_POSTGRES_TABLE="media,episodes"

# RabbitMQ connection. Credentials must match a user in generated definitions.
DEBEZIUM_RABBITMQ_HOST="rabbitmq"
DEBEZIUM_RABBITMQ_PORT=5672
DEBEZIUM_RABBITMQ_USER="${RABBITMQ_USER}"
DEBEZIUM_RABBITMQ_PASSWORD="${RABBITMQ_PASSWORD}"

# Queue created for the application's CDC consumer.
DEBEZIUM_RABBITMQ_QUEUE="movioza.cdc"

# Exchange and routing key used by the Debezium publisher.
DEBEZIUM_RABBITMQ_EXCHANGE="movioza.cdc"
DEBEZIUM_RABBITMQ_ROUTING_KEY="cdc"

# Connector namespace, replication slot and publication identifiers.
# Keep these identifiers stable across connector restarts.
DEBEZIUM_TOPIC_PREFIX="movioza"
DEBEZIUM_SLOT_NAME="movioza_cdc"
DEBEZIUM_PUBLICATION_NAME="movioza_cdc"